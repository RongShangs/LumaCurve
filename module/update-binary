#!/sbin/sh

ZIPFILE=$3
OUTFD=$2
MODULES_DIR=/data/adb/modules
MODULE_ID=luma_curve
MODDIR="$MODULES_DIR/$MODULE_ID"
UPGRADE_BOOTSTRAP=/data/local/tmp/.luma_curve_upgrade_helper.$$
LC_INSTALL_BOOTSTRAP=/data/local/tmp/.luma_curve_install_choice.$$
COMPAT_BOOTSTRAP=/data/local/tmp/.luma_curve_compatibility.$$
INSTALL_STAGE="$MODULES_DIR/.${MODULE_ID}.install.$$"
MODULE_BACKUP="$MODULES_DIR/.${MODULE_ID}.previous"
FAILED_MODULE="$MODULES_DIR/.${MODULE_ID}.failed.$$"
COMMIT_STARTED=0

ui_print() {
  echo "ui_print $1" > /proc/self/fd/$OUTFD
  echo "ui_print" > /proc/self/fd/$OUTFD
}

cleanup_bootstrap() {
  rm -f "$UPGRADE_BOOTSTRAP" "$LC_INSTALL_BOOTSTRAP" "$COMPAT_BOOTSTRAP" 2>/dev/null
}


extract_entry() {
  _entry="$1"
  _dest="$2"
  _parent=${_dest%/*}
  mkdir -p "$_parent" 2>/dev/null || return 1
  unzip -p "$ZIPFILE" "$_entry" > "$_dest" 2>/dev/null || return 1
  [ -s "$_dest" ]
}

restore_previous_module() {
  rm -rf "$FAILED_MODULE" 2>/dev/null
  if [ -d "$MODDIR" ]; then
    mv "$MODDIR" "$FAILED_MODULE" 2>/dev/null || return 1
  fi
  if [ -d "$MODULE_BACKUP" ]; then
    if ! mv "$MODULE_BACKUP" "$MODDIR" 2>/dev/null; then
      [ ! -d "$FAILED_MODULE" ] || mv "$FAILED_MODULE" "$MODDIR" 2>/dev/null
      return 1
    fi
  fi
  rm -rf "$FAILED_MODULE" "$INSTALL_STAGE" 2>/dev/null
  COMMIT_STARTED=0
  return 0
}

cancel_before_commit() {
  _reason="$1"
  lc_rollback_legacy_flags >/dev/null 2>&1
  ios_upgrade_restore >/dev/null 2>&1
  ios_upgrade_release_pause >/dev/null 2>&1
  ios_upgrade_fail "$_reason" >/dev/null 2>&1
  rm -rf "$INSTALL_STAGE" 2>/dev/null
  cleanup_bootstrap
  ui_print "安装失败：$_reason；原有模块与数据已保留。"
  exit 1
}

cancel_after_commit() {
  _reason="$1"
  lc_rollback_legacy_flags >/dev/null 2>&1
  _module_restored=1
  _data_restored=1
  restore_previous_module || _module_restored=0
  ios_upgrade_restore >/dev/null 2>&1 || _data_restored=0
  ios_upgrade_release_pause >/dev/null 2>&1 || _data_restored=0
  ios_upgrade_fail "$_reason" >/dev/null 2>&1
  cleanup_bootstrap
  if [ "$_module_restored" -eq 1 ] && [ "$_data_restored" -eq 1 ]; then
    ui_print "安装失败：$_reason；原有模块与数据已恢复。"
  else
    ui_print "安装失败：$_reason；自动恢复未完成，请检查备份。"
    ui_print "诊断记录：/data/adb/luma_curve/upgrade_status"
  fi
  exit 1
}

cancel_install() {
  trap - 1 2 3 15
  if [ "$COMMIT_STARTED" -eq 1 ]; then
    cancel_after_commit interrupted
  else
    cancel_before_commit interrupted
  fi
}

recover_interrupted_module_commit() {
  [ -d "$MODULE_BACKUP" ] || return 0
  _phase=$(ios_upgrade_status_value phase)
  case "$_phase" in
    ''|complete)
      if [ -d "$MODDIR" ]; then
        rm -rf "$MODULE_BACKUP" 2>/dev/null || return 1
      else
        mv "$MODULE_BACKUP" "$MODDIR" 2>/dev/null || return 1
      fi
      ;;
    *)
      COMMIT_STARTED=1
      restore_previous_module || return 1
      ;;
  esac
  return 0
}

trap cleanup_bootstrap 0
ui_print "LumaCurve · 流光亮度 1.0.0"
if ! unzip -p "$ZIPFILE" compatibility.sh > "$COMPAT_BOOTSTRAP" 2>/dev/null || [ ! -s "$COMPAT_BOOTSTRAP" ]; then
  ui_print "兼容性检测文件缺失。"; exit 1
fi
. "$COMPAT_BOOTSTRAP"
lc_compat_environment || exit 1
ui_print "[1/4] 检查冲突模块与安装环境"
if ! unzip -p "$ZIPFILE" install_choice.sh > "$LC_INSTALL_BOOTSTRAP" 2>/dev/null || [ ! -s "$LC_INSTALL_BOOTSTRAP" ]; then
  ui_print "安装检查文件解压失败。"
  exit 1
fi
. "$LC_INSTALL_BOOTSTRAP"
lc_check_legacy || { ui_print "安装已取消，原版模块保留。"; exit 1; }
ui_print "[2/4] 备份流光亮度配置与数据"
mkdir -p /data/local/tmp "$MODULES_DIR" 2>/dev/null
if ! unzip -p "$ZIPFILE" upgrade_data.sh > "$UPGRADE_BOOTSTRAP" 2>/dev/null ||
   [ ! -s "$UPGRADE_BOOTSTRAP" ]; then
  ui_print "数据维护文件解压失败。"
  exit 1
fi
. "$UPGRADE_BOOTSTRAP"
trap cancel_install 1 2 3 15

if ! recover_interrupted_module_commit; then
  ui_print "上次中断的安装恢复失败，请检查数据备份。"
  exit 1
fi

if ! ios_upgrade_begin; then
  ui_print "配置备份失败，安装已中止。"
  ui_print "诊断记录：/data/adb/luma_curve/upgrade_status"
  exit 1
fi

rm -rf "$INSTALL_STAGE" 2>/dev/null
mkdir -p "$INSTALL_STAGE/system/bin" "$INSTALL_STAGE/webroot" 2>/dev/null || cancel_before_commit stage_create_failed

ui_print "[3/4] 安装亮度引擎与轻量 WebUI"
for _file in compatibility.sh install_choice.sh LICENSE core_status.sh daemon_launcher.sh process_scope.sh module.prop service.sh customize.sh luma_curvectl.sh post-fs-data.sh check_status.sh uninstall.sh luma_curve.conf upgrade_data.sh; do
  extract_entry "$_file" "$INSTALL_STAGE/$_file" || cancel_before_commit "extract_failed_$_file"
done
for _file in index.html app.js styles.css kernelsu.js avatar.jpg donate-wechat.jpg donate-alipay.jpg LICENSE.txt; do
  extract_entry "webroot/$_file" "$INSTALL_STAGE/webroot/$_file" || cancel_before_commit "extract_failed_webroot_$_file"
done
if ! extract_entry system/bin/luma_curve_daemon "$INSTALL_STAGE/system/bin/luma_curve_daemon"; then
  extract_entry luma_curve_daemon "$INSTALL_STAGE/system/bin/luma_curve_daemon" || cancel_before_commit daemon_extraction_failed
fi

# Preserve the user's disabled state while replacing only packaged module files.
if [ -e "$MODDIR/disable" ]; then
  : > "$INSTALL_STAGE/disable" || cancel_before_commit disable_marker_copy_failed
fi

chmod 0755 "$INSTALL_STAGE" "$INSTALL_STAGE/system" "$INSTALL_STAGE/system/bin" "$INSTALL_STAGE/webroot" || cancel_before_commit stage_directory_chmod_failed
chmod 0755 "$INSTALL_STAGE/system/bin/luma_curve_daemon" "$INSTALL_STAGE/service.sh" "$INSTALL_STAGE/daemon_launcher.sh" "$INSTALL_STAGE/process_scope.sh" "$INSTALL_STAGE/customize.sh" "$INSTALL_STAGE/luma_curvectl.sh" "$INSTALL_STAGE/post-fs-data.sh" "$INSTALL_STAGE/check_status.sh" "$INSTALL_STAGE/uninstall.sh" || cancel_before_commit stage_executable_chmod_failed
chmod 0644 "$INSTALL_STAGE/core_status.sh" "$INSTALL_STAGE/module.prop" "$INSTALL_STAGE/luma_curve.conf" "$INSTALL_STAGE/upgrade_data.sh" "$INSTALL_STAGE/webroot/index.html" "$INSTALL_STAGE/webroot/app.js" "$INSTALL_STAGE/webroot/styles.css" "$INSTALL_STAGE/webroot/kernelsu.js" "$INSTALL_STAGE/webroot/avatar.jpg" "$INSTALL_STAGE/webroot/donate-wechat.jpg" "$INSTALL_STAGE/webroot/donate-alipay.jpg" "$INSTALL_STAGE/webroot/LICENSE.txt" "$INSTALL_STAGE/LICENSE" || cancel_before_commit stage_file_chmod_failed
[ ! -e "$INSTALL_STAGE/disable" ] || chmod 0644 "$INSTALL_STAGE/disable" || cancel_before_commit disable_marker_chmod_failed
lc_compat_probe "$INSTALL_STAGE/system/bin/luma_curve_daemon" "$INSTALL_STAGE" || cancel_before_commit compatibility_probe_failed

rm -rf "$MODULE_BACKUP" "$FAILED_MODULE" 2>/dev/null
COMMIT_STARTED=1
if [ -d "$MODDIR" ]; then
  mv "$MODDIR" "$MODULE_BACKUP" 2>/dev/null || cancel_after_commit module_backup_failed
fi
if ! mv "$INSTALL_STAGE" "$MODDIR" 2>/dev/null; then
  cancel_after_commit module_commit_failed
fi

if ! ios_upgrade_finish "$MODDIR/luma_curve.conf"; then
  cancel_after_commit persistent_data_finish_failed
fi

ui_print "[4/4] 完成模块切换"
lc_commit_legacy_removal || cancel_after_commit legacy_switch_failed
COMMIT_STARTED=0
rm -rf "$MODULE_BACKUP" "$FAILED_MODULE" 2>/dev/null

ui_print "LumaCurve 1.0.0"
ui_print "配置与数据已保留。"
ui_print "轻量 WebUI 已安装。"
ui_print "从模块管理器打开 WebUI 进行设置。"
ui_print ""
ui_print "安装完成，请重启设备。后续可在管理器检查更新并直接安装。"
